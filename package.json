{
  "name": "@g-cyberrpcore/framework",
  "version": "1.0.0",
  "description": "The Definitive Modular Roleplay Framework for Cyberpunk 2077 (CyberMP)",
  "main": "server.js",
  "scripts": {
    "test": "node --check server.js && node --check client.js && node --check config.js && node --check core/index.js && node --check core/player.js && node --check core/database.js && node --check core/admin_server.js",
    "orchestrator": "powershell -ExecutionPolicy Bypass -File tools/gcyber-deploy.ps1",
    "sync-ecosystem": "powershell -ExecutionPolicy Bypass -File tools/gcyber-deploy.ps1 -Command sync",
    "deploy-ecosystem": "powershell -ExecutionPolicy Bypass -File tools/gcyber-deploy.ps1 -Command deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/G-CyberRPcore/G-CyberRPcore.git"
  },
  "keywords": [
    "cyberpunk2077",
    "cybermp",
    "roleplay",
    "framework",
    "multiplayer",
    "g-cyberrpcore"
  ],
  "author": "G-CyberRPcore Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/G-CyberRPcore/G-CyberRPcore/issues"
  },
  "homepage": "https://github.com/G-CyberRPcore",
  "devDependencies": {
    "@cybermp-community/client-types": "^2.6.1"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  }
}
